#!/bin/bash
# sys-vpn-wireguard/setup.sh - load WireGuard configs into a disposable VPN qube at boot.
@@NOTE@@#
# Run as root in the VPN qube's DISPOSABLE TEMPLATE (e.g. sys-vpn-dvm), not in
# the disposable itself. Either, inside the disposable template:
#   sudo bash setup.sh [--qube sys-vpn] [--default wg-xx]
# or from dom0, after copying setup.sh into the disposable template:
#   qvm-run -u root -p sys-vpn-dvm 'bash /home/user/QubesIncoming/<qube>/setup.sh'
#
# Options:
#   --qube NAME      name of the VPN qube that should load the configs (default sys-vpn)
#   --default NAME   config to bring up (file name without .conf); default: random
#
# Installs (re-running replaces the script and keeps your configs):
#   /rw/config/rc.local.d/vpn-autoconnect.rc   0755  imports the configs at boot
#   /usr/local/etc/wg-configs/                 0700  WireGuard .conf files
#
# Needs NetworkManager in the template (qubes-core-agent-network-manager).

set -euo pipefail

QUBE=sys-vpn
DEFAULT=
while [ $# -gt 0 ]; do
    case "$1" in
        --qube) QUBE=${2:?--qube needs a name}; shift 2 ;;
        --default) DEFAULT=${2:?--default needs a name}; shift 2 ;;
        -h|--help) sed -n '2,22p' "$0" 2>/dev/null || true; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
[[ $QUBE =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || { echo "invalid qube name: $QUBE" >&2; exit 2; }
[[ -z $DEFAULT || $DEFAULT =~ ^[A-Za-z0-9_=+.-]{1,15}$ ]] || { echo "invalid config name: $DEFAULT (max 15 characters)" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo "run as root (see the top of this file)" >&2; exit 1; }
if [ "$(qubesdb-read /qubes-vm-persistence 2>/dev/null || true)" = none ]; then
    echo "this is a disposable: anything installed here is lost at shutdown." >&2
    echo "run it in the disposable template instead (e.g. sys-vpn-dvm)." >&2
    exit 1
fi
command -v nmcli >/dev/null || echo "WARN: nmcli not found: the template needs NetworkManager" >&2

@@EMBED@@
F_VPN_AUTOCONNECT_RC=${F_VPN_AUTOCONNECT_RC/vpn_qube=\"sys-vpn\"/vpn_qube=\"$QUBE\"}
F_VPN_AUTOCONNECT_RC=${F_VPN_AUTOCONNECT_RC/default_vpn=\"\"/default_vpn=\"$DEFAULT\"}

install -d -m 0755 /rw/config/rc.local.d
dest=/rw/config/rc.local.d/vpn-autoconnect.rc
printf '%s\n' "$F_VPN_AUTOCONNECT_RC" > "$dest.new"
chown root:root "$dest.new"; chmod 0755 "$dest.new"; mv -f "$dest.new" "$dest"
install -d -m 0700 -o root -g root /usr/local/etc/wg-configs

echo "installed $dest (VPN qube: $QUBE, default: ${DEFAULT:-random}) and /usr/local/etc/wg-configs/"
echo "add a config from dom0 (piped through, never shown in dom0):"
echo "  qvm-run --pass-io <source qube> 'cat ~/wg-xx.conf' |"
echo "    qvm-run -u root --pass-io $(qubesdb-read /name 2>/dev/null || echo '<this dvm>') 'umask 077; cat > /usr/local/etc/wg-configs/wg-xx.conf'"
